# Required: generate a strong random token
# Windows:  python -c "import secrets; print(secrets.token_hex(32))"
# Linux:    openssl rand -hex 32
REMOTE_PC_MCP_TOKEN=change-me-to-a-long-random-string

# Optional: bind address and port (default: all interfaces, port 8765)
# Set to your Tailscale IP to restrict access to your tailnet only
REMOTE_PC_MCP_HOST=0.0.0.0
REMOTE_PC_MCP_PORT=8765

# Optional resource caps. Defaults shown; uncomment to override.
# REMOTE_PC_MCP_MAX_SHELL_TIMEOUT=600
# REMOTE_PC_MCP_MAX_READ_BYTES=52428800
# REMOTE_PC_MCP_MAX_WRITE_BYTES=52428800
# REMOTE_PC_MCP_MAX_DOWNLOAD_BYTES=2147483648

# Optional: enable DNS-rebinding protection by listing allowed Host headers.
# Default (empty) disables it — fine for tailnet/LAN use since the bearer token
# is already enforced. Set to a comma-separated list to lock it down.
# REMOTE_PC_MCP_ALLOWED_HOSTS=my-host.example.ts.net,192.0.2.10
